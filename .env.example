# Шаблон .env. Скопировать в .env и заполнить: cp .env.example .env
# Реальный .env в git не попадает.

# True на боевом сервере (боевой бот, домен из URL)
IS_PROD=True

# ─── Домен (HTTPS) ────────────────────────────────────────────────────────────
# сайт выбора мест и вебхук бота: https://<домен>/kino/..., https://<домен>/webhook
DOMAIN=example.ru
URL=https://example.ru
URL_SERVER=https://example.ru
# docker-сеть общего nginx-proxy на сервере:
#   docker inspect edge-nginx --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=

# ─── Бот MAX ──────────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_BOT_TOKEN_TEST=
WEBHOOK_SECRET=
# WEBHOOK_HOST/WEBHOOK_PORT задаёт docker-compose.yaml

# ─── База ─────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
# db — контейнер базы из docker-compose.yaml
POSTGRES_DB_URL=postgresql://username_kino:<POSTGRES_PASSWORD>@db:5432/dbname_kino

# ─── Билетная система кинотеатров ─────────────────────────────────────────────
URL_KINO_BAZA=http://195.208.148.248:18088/TicketAutomat/get.php

# ─── ЮKassa ───────────────────────────────────────────────────────────────────
YOUKASSA_SHOP_ID=
YOUKASSA_SECRET_KEY=

# ─── PRO.Культура.РФ (реестр /pushkinsCardEvents) ─────────────────────────────
URL_PROKULTURA=https://pro.culture.ru/api/2.5/pushkinsCardEvents
PROKULTURA_API_KEY=

# ─── Сервис оператора «Пушкинской карты» (ВТБ, метод tickets/check) ──────────
VALIDATION_URL=https://pushkin.api.vtb.ru/outside/public/app/publicapi/rb/dks/culturecardpaymentcheck/v1/tickets/check
# токен из PRO.Культура.РФ: «Учреждение» → «Пушкинская карта» → «Токены для сервиса Банк ВТБ»
POCHTA_BANK_TOKEN=
# срок действия токена (YYYY-MM-DD) — бот заранее напомнит админу
POCHTA_BANK_TOKEN_EXPIRES=
# Acquiring Institution Identification Code из карточки терминала на PRO.Культура.РФ
PUSHKIN_TERM_INST_ID=70372200101

# ─── ЕАИС (загрузка XML на ekinobilet.ru) ─────────────────────────────────────
EKINOBILET_LOGIN=
EKINOBILET_PASSWORD=

# ─── Прочее ───────────────────────────────────────────────────────────────────
KINOPOISK_TOKEN=
# секретный ключ Django (любая длинная случайная строка)
DJANGO_SECRET_KEY=
